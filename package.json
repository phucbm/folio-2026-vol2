{
  "name": "folio-2026-vol2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/content-meta.mjs && next dev",
    "build": "node scripts/content-meta.mjs && next build && node scripts/check-paper.mjs && node scripts/check-seo.mjs",
    "cf:build": "opennextjs-cloudflare build && node scripts/cf-assets.mjs",
    "check:paper": "node scripts/check-paper.mjs",
    "typecheck": "node scripts/content-meta.mjs && tsc --noEmit",
    "test": "vitest run",
    "content:lint": "node scripts/lint-content.mjs",
    "content:meta": "node scripts/content-meta.mjs",
    "data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/data/fetch.mjs",
    "visuals": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/visuals/cli.mjs",
    "preview": "pnpm cf:build && wrangler dev",
    "deploy": "pnpm cf:build && opennextjs-cloudflare deploy"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "glob@>=10.2.0 <10.5.0": "^10.5.0"
    }
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.119",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.8",
    "@opennextjs/cloudflare": "^1.20.10",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@perxel/spotlight": "file:../../perxel/perxel-spotlight",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@types/mdx": "^2.0.14",
    "ai": "7.0.116",
    "clsx": "^2.1.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0",
    "yaml": "2.9.1"
  },
  "dependenciesMeta": {
    "@perxel/spotlight": {
      "injected": true
    }
  }
}
