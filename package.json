{
  "name": "folio-2026-vol2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/content-meta.mjs && next dev",
    "build": "node scripts/content-meta.mjs && next build && node scripts/check-paper.mjs && node scripts/check-seo.mjs",
    "check:paper": "node scripts/check-paper.mjs",
    "start": "npx serve out",
    "typecheck": "node scripts/content-meta.mjs && tsc --noEmit",
    "test": "vitest run",
    "content:lint": "node scripts/lint-content.mjs",
    "content:meta": "node scripts/content-meta.mjs",
    "data": "node --env-file-if-exists=.env.local scripts/data/fetch.mjs",
    "visuals": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/visuals/cli.mjs",
    "preview": "pnpm build && wrangler dev",
    "deploy": "pnpm data && SHOW_DRAFTS=1 pnpm build && wrangler deploy"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.8",
    "@types/mdx": "^2.0.14",
    "clsx": "^2.1.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0",
    "yaml": "2.9.1"
  }
}
